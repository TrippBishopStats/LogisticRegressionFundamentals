@article{brixner_1327-p_2025,
	title = {1327-{P}: {Body} {Mass} {Index} in {People} with {Type} 1 {Diabetes} with and without {Prior} {Type} 2 {Diabetes} {Diagnosis}—{A} {U}.{S}. {Managed} {Care} {Population}},
	volume = {74},
	issn = {0012-1797},
	shorttitle = {1327-{P}},
	url = {https://diabetesjournals.org/diabetes/article/74/Supplement_1/1327-P/160025/1327-P-Body-Mass-Index-in-People-with-Type-1},
	doi = {10.2337/db25-1327-P},
	abstract = {Introduction and Objective: Around 40\% of adults with type 1 diabetes (T1D) are misdiagnosed with type 2 diabetes (T2D). Elevated body mass index (BMI) is frequently used as an indicator of T2D; however, people with T1D may have high BMI values, and this may contribute to being misdiagnosed with T2D.
            Methods: This observational study used claims from the Healthcare Integrated Research Database (Oct 1, 2015, to Dec 31, 2023). People with ≥2 outpatient claims for T1D 30-183 days apart or ≥1 inpatient claim (index date was first T1D diagnosis), and 12 months’ continuous health insurance before (baseline) and after index (follow-up), were included. People with ≥2 T2D diagnoses or only 1 T1D diagnosis during 12-month follow-up, or secondary diabetes or pregnancy during 12-month baseline, were excluded. Baseline BMI and obesity were compared between adults (≥18 years) with and without prior T2D diagnosis.
            Results: Of 5715 adults with an index T1D diagnosis, 2468 (43\%) had a prior T2D diagnosis (41\% female; mean age: 48 years), and 3247 (57\%) had no prior T2D diagnosis (40\% female; mean age: 42 years). In people with and without prior T2D diagnosis, mean (SD) BMI was 28.0 (6.6) and 27.4 (6.1) (mean difference: -0.69 [CI: -2.63-1.25]). Obesity was reported in 13\% and 6\% (prevalence ratio: 0.49 [CI: 0.41-0.58) of people with T1D with and without prior T2D diagnosis.
            Conclusion: In adults with a T1D diagnosis, those with a prior T2D diagnosis had a slightly higher BMI and were more frequently obese compared with people without a prior T2D diagnosis; however, mean BMI was categorized as overweight in both groups. These findings may indicate a potential source of prior misdiagnosis in people with a T1D diagnosis, as clinicians may erroneously attribute a high BMI and/or excess bodyweight to T2D. This further emphasizes the need for improved diagnostic measures to ensure timely and appropriate T1D management.
            
              Disclosure
              D. Brixner: Consultant; Sanofi. Research Support; Dexcom, Inc. Consultant; Insulet Corporation, Tandem Diabetes Care, Inc. T.J. Beyene: Research Support; Sanofi. Employee; Carelon Research. M. Venkataraman: Research Support; Sanofi. Employee; Carelon Research. C. Teng: Research Support; Sanofi. Employee; Carelon Research. Stock/Shareholder; Elevance Health. H.P. Chen: Research Support; Sanofi. H. Tan: Research Support; Sanofi. Employee; Carelon Research. L. Wilson: Employee; Sanofi-Aventis U.S. Stock/Shareholder; Sanofi-Aventis U.S. A. Cagle: Employee; Sanofi-Aventis U.S. M. Borysyuk: Employee; Sanofi. Stock/Shareholder; Sanofi. D.C. Malone: Consultant; Sanofi, Tandem Diabetes Care, Inc, AstraZeneca, Biogen, Sarepta, Humacyte, Otsuka America Pharmaceutical, Inc, Ionis Pharmaceuticals.
            
            
